<?xml version='1.0' encoding='utf-8'?>
<widget android-versionCode="1" id="de.hrzg.shopeur" ios-CFBundleVersion="0.0.1" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:gap="http://phonegap.com/ns/1.0">
    <name>Shopeur</name>
    <description>
    Add your desription here
  </description>
    <author email="m.mautz@herzogkommunikation.de">
